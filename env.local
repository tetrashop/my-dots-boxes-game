cat > .env.local << 'EOF'
# ===== تنظیمات برای مقابله با تحریم =====
NEXT_PUBLIC_USE_FALLBACK_RPC=true
NEXT_PUBLIC_FALLBACK_RPCS=https://rpc.sepolia.org,https://rpc.ankr.com/eth_sepolia,https://cloudflare-eth.com
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_USE_DECENTRALIZED_AUTH=true
NEXT_PUBLIC_OFFLINE_MODE=true

# بقیه تنظیمات
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEFAULT_GRID_SIZE=4
NEXT_PUBLIC_DEFAULT_PLAYERS=2
NEXT_PUBLIC_DAILY_BONUS=3
NEXT_PUBLIC_INITIAL_BALANCE=10
EOF
